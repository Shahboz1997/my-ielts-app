# =============================================================================
# STRATUM.ai — environment template
# =============================================================================
# 1. Copy this file:  cp .env.example .env.local   (Windows: copy .env.example .env.local)
# 2. Fill in real values below. Never commit .env.local (it is gitignored).
# 3. Minimum to run locally: DATABASE_URL, DIRECT_URL, AUTH_SECRET, OPENAI_API_KEY, NEXTAUTH_URL
# =============================================================================

# --- Site URL (origin only, no path) ---
# Must match the URL you open in the browser (OAuth redirect URIs depend on this).
NEXTAUTH_URL=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3000

# --- Auth secret (required in production) ---
# Generate: openssl rand -base64 32
# Use AUTH_SECRET only — do not set both AUTH_SECRET and NEXTAUTH_SECRET to different values.
AUTH_SECRET=

# Google sign-in (optional) — also register BOTH redirect URIs in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   http://127.0.0.1:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Database (PostgreSQL / Supabase) ---
# Runtime app: Supabase **Transaction** pooler (port 6543), add ?pgbouncer=true if needed.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Prisma migrate / db push: **Session** pooler (5432) or direct connection string.
DIRECT_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- OpenAI (essay check, Task 1/2 generation) ---
OPENAI_API_KEY=sk-your-key-here
# Required when using project-scoped keys (sk-proj-...):
# OPENAI_PROJECT_ID=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Cron: practice email reminders (/api/cron/practice-reminders) ---
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Telegram bot — 2× daily group posts + /start /tip commands ---
# TELEGRAM_BOT_TOKEN=
# Group chat id (add bot to group as admin). Also accepts TELEGRAM_CHANNEL_ID.
# TELEGRAM_GROUP_ID=-1001234567890
# Optional webhook hardening:
# TELEGRAM_WEBHOOK_SECRET=
# After deploy: node --env-file=.env.local scripts/telegram-set-webhook.js
# Manual post test:
# curl -H "Authorization: Bearer $CRON_SECRET" "https://YOUR_DOMAIN/api/cron/telegram-daily?slot=morning"

# --- SMTP for reminder emails (optional locally; required on prod if cron is enabled) ---
EMAIL_USER=
EMAIL_PASS=

# --- Admin API (/api/admin/*) — comma-separated allowed emails ---
ADMIN_EMAILS=admin@example.com

# --- Writing bank: POST /api/templates (production) ---
# Request header: x-bank-admin-key: <BANK_ADMIN_KEY>
# In development, POST is allowed without the key.
# BANK_ADMIN_KEY=

# --- Optional ---
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# BANK_TOPIC_CACHE_TTL_MS=120000
# Extra next/image hosts only (sample charts already allowlisted in src/lib/allowedImageHosts.js).
# Placeholders like cdn.example.com do nothing unless you host images there.
# IMAGE_ALLOWED_HOSTS=

# --- Playwright E2E (see .env.e2e.example) ---
# E2E_MOCK_OPENAI=1  # mocks essay check only; Task 1 chart vision still uses OpenAI
# E2E_TEST_EMAIL=e2e@example.com
# E2E_TEST_PASSWORD=
