# Copy values into .env.local for local Playwright runs (npm run test:e2e).

E2E_MOCK_OPENAI=1
E2E_TEST_EMAIL=e2e@example.com
E2E_TEST_PASSWORD=your-e2e-password-min-6

# Required (same as dev): DATABASE_URL, AUTH_SECRET or NEXTAUTH_SECRET, NEXTAUTH_URL=http://127.0.0.1:3000
# OPENAI_API_KEY can be omitted when E2E_MOCK_OPENAI=1
