# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Channel chat id: @your_channel or -1001234567890
# Bot must be admin with "Post messages" permission.
TELEGRAM_CHAT_ID=@your_ielts_channel

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Schedule (24 h clock, local timezone)
TIMEZONE=Europe/Moscow
MORNING_HOUR=9
EVENING_HOUR=18

# Optional
SITE_URL=https://stratumielts.com/
MORNING_QUIZ_DELAY_MINUTES=5

# Set to 1 to send one morning post immediately on startup (testing)
# RUN_ON_START=1
